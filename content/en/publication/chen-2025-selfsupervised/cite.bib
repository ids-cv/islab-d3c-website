@inproceedings{chen2025selfsupervised,
 abstract = {Lattice light-sheet microscopy illuminates specimens with a thin light sheet to reduce image degradation caused by light scattering, unlike conventional uniform illumination. However, this approach is still unable to fully eliminate the blur introduced by the optical system. To address this problem, non-blind deconvolution techniques, such as Richardson-Lucy, are commonly used but they often introduce noise artifacts while deep supervised learning approaches require costly ground truth data. In this paper, we propose a self-supervised learning framework that explicitly integrates the imaging model with 3D neural network for reconstructing high-quality images without ground truth data by leveraging the optics of the microscopy and its point spread function. Extensive experiments demonstrate our superior performance over baseline algorithm both quantitatively and qualitatively.},
 author = {Chen, Zi-Yi and Suetsugu, Shiro and Mimori-Kiyosue, Yuko and Nagahara, Hajime},
 booktitle = {Proceedings of the International Conference on Machine Vision Applications (MVA)},
 doi = {10.23919/MVA65244.2025.11175111},
 month = {July},
 pages = {1--6},
 title = {Self-supervised 3D Image Deblurring for Lattice Light Sheet Microscopy},
 url = {https://doi.org/10.23919/MVA65244.2025.11175111},
 year = {2025}
}
