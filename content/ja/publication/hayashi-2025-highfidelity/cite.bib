@inproceedings{hayashi2025highfidelity,
 abstract = {We have proposed charge-domain time-compressive LiDAR image sensors that compress the scene response using an indirect time-of-flight (ToF) sensor and compressive sensing. The scene's impulse response is reconstructed in post-processing. Because these image sensors are based on an indirect ToF sensor using multitap charge modulators, they are suitable for high spatial resolution. They can achieve high distance measurement accuracy by reconstructing the scene response to estimate ToF. Since the ToF estimation relies on the reconstructed scene response, its fidelity is crucial. In this paper, we compared a deep learning model inspired by an iterative optimization method with a conventional total variation-based iterative method. We assumed an application to autonomous robotic vacuum cleaners in which multipath interference between the floor and the wall may introduce significant depth errors. In both simulations and experiments, we confirmed that regularization based on a U-Net in ADMM-Net achieves higher fidelity in the reconstructed waveform than TVAL3.},
 author = {Hayashi, Daisuke and Yoshida, Michitaka and Teranishi, Nobukazu and Yasutomi, Keita and Kawahito, Shoji and Nagahara, Hajime and Kagawa, Keiichiro},
 booktitle = {Proceedings of the IEEE International Conference on Image Processing (ICIP)},
 doi = {10.1109/ICIPW68931.2025.11386204},
 month = {September},
 pages = {404--409},
 title = {High-Fidelity Scene Response Reconstruction For Flash Lidar Using Charge-Domain Time-Compressive Tof Image Sensor},
 url = {https://doi.org/10.1109/ICIPW68931.2025.11386204},
 year = {2025}
}
